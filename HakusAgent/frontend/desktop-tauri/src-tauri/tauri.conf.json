{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HakusAI",
  "mainBinaryName": "HakusAI",
  "version": "0.3.0",
  "identifier": "com.hakusai.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "HakusAI",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:* https://opencode.ai; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true,
        "installMode": "currentUser",
        "installerHooks": "windows/installer-hooks.nsh",
        "template": "windows/installer-template.nsi",
        "sidebarImage": "windows/installer/welcome.bmp",
        "headerImage": "windows/installer/header.bmp"
      }
    },
    "license": "windows/license.txt"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/modemneko/HakusAgent/releases/download/stable/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENGMTIzNDBBRUM1Mzc0MzgKUldRNGRGUHNDalFTejgzRUdsa2VRVE5BSXZQZ2YvdlVmd0lBY2NSME0wejJMTnJpUzlPM3VrNC8K"
    },
    "shell": {}
  }
}
