<?xml version="1.0" encoding="utf-8"?>
<!--
  Loopback-only cleartext exemption.

  The embedded Rust Runtime API serves http://127.0.0.1:48081 inside the same
  app process. WebView fetches to that loopback endpoint are plain HTTP, which
  Android 9+ blocks by default in release builds. Loopback traffic never
  leaves the device, so it is exempted here; every other cleartext destination
  remains blocked. Remote servers must use HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
