__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# Anchor lib/ to repo root — Python's installed-packages dir lives at ./lib/
# Without the leading slash, this rule would also exclude nested lib/ dirs
# like frontend/client/src/lib/ (which is a legitimate TypeScript module).
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Project specific
*.log
logs/
.env
.env.local
.config.py

# OS
.DS_Store
Thumbs.db
desktop.ini

# Node (if frontend)
node_modules/
dist/

# Temporary files
*.tmp
*.temp
.cache/

# Local Hakus runtime state and Android/Gradle caches
.hakus/
**/.gradle/

# Legacy Python test/runtime state. User data belongs under the platform
# application-data directory and must never be shipped from the repository.
data/user_states/
data/cache/
src/data/memories/

# Model files (large)
*.pt
*.pth
*.onnx
*.bin
!**/live2d-models/**  # Keep Live2D models

# Audio files (generated)
*.wav
*.mp3
!**/assets/**  # Keep asset files

/voxcpm
config.yaml
config.yaml
scripts/test_guardian_llm.py
scripts/test_p3_evolution.py
scripts/test_p5_guardian_e2e.py

# AI 会话状态文件，勿提交
.task_board.json
.workspace_state.json
.orchestrator-checkpoint.json
.long_task_context.json

# Rust / Tauri build outputs (installer + desktop)
**/src-tauri/target/
**/src-tauri/gen/

# Local tooling / counters / agent scratch (never commit)
.VSCodeCounter/
.trae/
.workbuddy/
.cdp.mjs
.zcodeignore

# Agent / smoke scratch workspaces. Each is a throwaway HOME or WebView2 user
# data tree produced by a verification run; none of it is source.
.dsh-*/
.android-sim/
.profile-recovery-backup/
android-log.txt

# UI Automator hierarchy dumps. These capture whatever was on screen verbatim,
# including text typed into password fields, so they must never be committed.
scripts/*.xml
scripts/audit/

# Verification screenshots. Renders kept as evidence live in doc/; these are
# the raw frames a script happened to dump while iterating.
scripts/*.png

# Compiled helper binaries. Their sources (main.rs / .ps1 / .cmd) are tracked;
# these are per-machine builds of them.
scripts/*.exe
scripts/*.pdb

# Build outputs of the Android ASR plugin's Gradle module.
**/src-tauri/plugins/*/android/build/
**/src-tauri/plugins/*/android/.gradle/
**/src-tauri/plugins/*/android/.tauri/
**/src-tauri/plugins/*/.aar-inspect/

# The sherpa-onnx Kotlin runtime is a 50 MB third-party binary. It is a build
# input downloaded out of band, not a portable extension; see
# docs/ANDROID_ASR_REVIEW.md, which records that no redistribution decision has
# been made. Keep it out of the repository until one is.
**/src-tauri/plugins/*/android/libs/*.aar

# Transient API payloads captured from the GitHub REST API during release work.
/jobs.json
/run.json
frontend/terminal-fix.patch
