# Local agent-debug tooling (dev-only, never commit)
.dbg/

# ZCode harness local plans workspace (auto-created, never commit)
.zcode/

# Stray scratch/experiment dirs (not part of project)
frontier-swe/

# Local PyInstaller build artifacts (CI rebuilds these)
frontend/client/sidecar/build/
frontend/client/sidecar/build-debug/
frontend/client/sidecar/dist/
frontend/client/sidecar/dist-debug/
frontend/client/sidecar/hakusai_server_entry.py
